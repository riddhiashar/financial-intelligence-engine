# Dockerfile.api
# FastAPI backend container

FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY notebook/requirements.txt .

# use torch==2.12.1 — matches requirements.txt and supports Python 3.13
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        torch==2.12.1 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

COPY notebook/main.py .
COPY notebook/predict.py .
COPY notebook/vector_db.py .
COPY notebook/embedding_pipeline.py .
COPY notebook/semantic_search.py .
COPY notebook/metadata_pipeline.py .
COPY notebook/rag_pipeline.py .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
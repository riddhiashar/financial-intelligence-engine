# .env.example
# Copy this file to .env and update values if needed
# Default values work for local Docker deployment

# Qdrant vector database host
# Use 'qdrant' when running with docker-compose
# Use 'localhost' when running locally without Docker
QDRANT_HOST=qdrant

# Ollama LLM host
# Use 'host.docker.internal' when running with docker-compose on Windows/Mac
# Use 'localhost' when running locally without Docker
OLLAMA_HOST=host.docker.internal

# FastAPI base URL for Streamlit to connect to
# Use 'http://api:8000' when running with docker-compose
# Use 'http://localhost:8000' when running locally without Docker
API_BASE_URL=http://api:8000